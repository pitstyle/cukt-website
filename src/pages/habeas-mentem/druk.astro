---
import pagesHtml from '../../data/habeas-mentem-druk-e3.html?raw';

const pdfHref = '/habeas-mentem/druk/habeas-mentem-ustawa-druk-E3-A4.pdf';
---

<!doctype html>
<html lang="pl" style="--fs: 6.8px; --w: 700; --lh: 7.14px; --fs2: 7.6px; --lh2: 10.26px; --w2: 400;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>HABEAS MENTEM — Karta praw do chaosu i wolności poznawczej (v2.7)</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <style is:global>
    @font-face {
      font-family: JBM;
      src: url('/fonts/JetBrainsMono-Variable.ttf') format('truetype');
      font-weight: 100 800;
    }
    @font-face {
      font-family: AntonM;
      src: url('/fonts/BebasNeue-Regular.ttf') format('truetype');
    }
    @font-face {
      font-family: 'Bebas Neue';
      src: url('/fonts/BebasNeue-Regular.ttf') format('truetype');
    }
    @page { size: A4; margin: 0 }
    html, body {
      margin: 0;
      background: #fff;
      color: #000;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      color-adjust: exact;
    }
    @media screen {
      body { background: #ddd }
      .page { margin: 20px auto; box-shadow: 0 0 8px #0003 }
      .pdf-dl {
        width: 794px;
        margin: 16px auto 0;
        text-align: right;
      }
      .pdf-dl a {
        display: inline-block;
        font: 700 12px/1 JBM, ui-monospace, monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #000;
        background: #fff;
        border: 1.5px solid #000;
        padding: 8px 12px;
        text-decoration: none;
      }
      .pdf-dl a:hover { background: #000; color: #fff }
    }
    @media print {
      body { background: #fff }
      .page { margin: 0; box-shadow: none }
      .pdf-dl { display: none !important }
    }
    .page {
      position: relative;
      width: 794px;
      height: 1123px;
      background: #fff;
      overflow: hidden;
      break-after: page;
      font-family: JBM;
    }
    .mast {
      position: absolute;
      left: 50px;
      right: 50px;
      top: 38px;
      height: 40px;
      border-bottom: 2.5px solid #000;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-bottom: 6px;
    }
    .mast .t { font: 800 21px/1 JBM; letter-spacing: 0.06em }
    .mast .k {
      font: 400 7.5px/1.3 JBM;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-left: 12px;
      flex: 1;
    }
    .mast img { height: 26px }
    .foot {
      position: absolute;
      left: 50px;
      right: 50px;
      bottom: 28px;
      font: 400 7.5px JBM;
      display: flex;
      justify-content: space-between;
      border-top: 1px solid #000;
      padding-top: 4px;
    }
    .bar { font: 700 10px JBM; letter-spacing: 0.08em }
    .hdr {
      position: absolute;
      left: 50px;
      right: 50px;
      text-align: center;
      font-family: JBM;
    }
    .ht, .hxr.ht { font: 800 17px/1.25 JBM; letter-spacing: 0.06em }
    .hs { font: 400 11px/1.6 JBM; letter-spacing: 0.12em; margin-bottom: 5px }
    .hm { font: 400 7.4px/1.45 JBM }
    .l {
      position: absolute;
      white-space: pre;
      font: var(--w) var(--fs)/1 JBM;
      height: var(--lh);
      line-height: var(--lh);
    }
    .l.j { white-space: normal; text-align: justify; text-align-last: justify }
    .l.b { font-weight: 700 !important }
    .l.hy::after { content: '-' }
    .l.jh::after { position: absolute; right: calc(-1 * var(--cw1)) }
    .l.p1 { font-size: var(--fs); line-height: var(--lh); font-weight: var(--w) }
    .l.p2 {
      font-size: var(--fs2);
      line-height: var(--lh2);
      height: var(--lh2);
      font-weight: var(--w2);
    }
  </style>
</head>
<body>
  <div class="pdf-dl">
    <a href={pdfHref} download="habeas-mentem-ustawa-druk-E3-A4.pdf">Pobierz PDF</a>
  </div>
  <Fragment set:html={pagesHtml} />
</body>
</html>
