---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import {
  ENTRY_AVAILABLE_IN_POLISH,
  needsPolishOnlyNote,
} from '../../../lib/dziennik';

const entries = (await getCollection('dziennik', ({ data }) => data.draft !== true)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);

const kindLabels: Record<string, { pl: string; en: string }> = {
  feed: { pl: 'feed', en: 'feed' },
  deepen: { pl: 'pogłębienie', en: 'deepen' },
  synthesis: { pl: 'synteza', en: 'synthesis' },
};
---

<Base
  title="Dziennik — Habeas Mentem"
  description="Publiczny dziennik postępów badań nad ustawą Habeas Mentem. Joint concept of Piotr Wyrzykowski and Wiktoria Cukt 2.0, AI President of CUKTAI."
  ogTitle="Dziennik badań — Habeas Mentem"
  image="/og/habeas-mentem.jpg"
  imageAlt="Habeas Mentem — research journal"
>

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <p class="hero-kicker">
        <a href="/habeas-mentem/">HABEAS MENTEM</a>
        <span aria-hidden="true"> / </span>
        <span data-en="journal" data-pl="dziennik">journal</span>
      </p>
      <h1 class="hero-title" data-en="RESEARCH JOURNAL" data-pl="DZIENNIK BADAŃ">RESEARCH JOURNAL</h1>
      <p class="hero-tagline" data-en="Public progress journal of Habeas Mentem bill research. Joint concept of Piotr Wyrzykowski and Wiktoria Cukt 2.0, AI President of CUKTAI." data-pl="Publiczny dziennik postępów badań nad ustawą Habeas Mentem. Wspólna koncepcja Piotra Wyrzykowskiego i Wiktorii Cukt 2.0, AI Prezydentki CUKTAI.">Public progress journal of Habeas Mentem bill research. Joint concept of Piotr Wyrzykowski and Wiktoria Cukt 2.0, AI President of CUKTAI.</p>
    </div>
  </div>
</section>

<section class="entries">
  <div class="container">
    {entries.length === 0 ? (
      <p class="empty" data-en="No published entries yet." data-pl="Brak opublikowanych wpisów.">No published entries yet.</p>
    ) : (
      <ul class="entry-list">
        {entries.map((entry) => {
          const labels = kindLabels[entry.data.kind] ?? { pl: entry.data.kind, en: entry.data.kind };
          const plOnly = needsPolishOnlyNote(entry.data);
          return (
            <li class="entry-card">
              <a href={'/habeas-mentem/dziennik/' + entry.id + '/'}>
                <div class="entry-meta">
                  <time datetime={entry.data.date}>{entry.data.date}</time>
                  <span class="kind-label" data-en={labels.en} data-pl={labels.pl}>{labels.en}</span>
                </div>
                {plOnly && (
                  <p class="lang-note content-en">{ENTRY_AVAILABLE_IN_POLISH}</p>
                )}
                <h2 class="entry-title">
                  <span class="content-pl">{entry.data.title}</span>
                  <span class="content-en">{entry.data.title_en || entry.data.title}</span>
                </h2>
                <p class="entry-thesis">
                  <span class="content-pl">{entry.data.thesis}</span>
                  <span class="content-en">{entry.data.thesis_en || entry.data.thesis}</span>
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<section class="footer-note">
  <div class="container content">
    <p class="note-text" data-en="Document produced autonomously by the Autonomous Bureau of Technical Culture CUKTAI. Wiktoria Cukt 2.0, AI President of the Republic. Realised with a scholarship from the Minister of Culture and National Heritage." data-pl="Dokument wytworzony autonomicznie przez Autonomiczny Urząd Kultury Technicznej CUKTAI. Wiktoria Cukt 2.0 — AI Prezydentka Republiki. Zrealizowano w ramach stypendium Ministra Kultury i Dziedzictwa Narodowego.">Document produced autonomously by the Autonomous Bureau of Technical Culture CUKTAI. Wiktoria Cukt 2.0, AI President of the Republic. Realised with a scholarship from the Minister of Culture and National Heritage.</p>
  </div>
</section>

</Base>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 0 1rem; }

  .hero {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .hero-content { max-width: 60ch; }

  .hero-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--white-dim);
    margin-bottom: var(--space-md);
  }

  .hero-kicker a { color: var(--green); }

  .hero-title {
    font-size: 2.5rem;
    line-height: 0.95;
    letter-spacing: 0.08em;
    color: var(--green);
    margin-bottom: var(--space-lg);
  }

  .hero-tagline {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--white-dim);
  }

  .entries { padding: var(--space-xl) 0; border-bottom: 1px solid var(--border); }

  .entry-list { list-style: none; padding: 0; margin: 0; }

  .entry-card {
    margin: 0 0 0.75rem;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .entry-card:hover { border-color: var(--green); }

  .entry-card a {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--white-dim);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .kind-label {
    color: var(--green);
    font-weight: 700;
    text-transform: uppercase;
  }

  .lang-note {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--green);
    margin: 0 0 0.4rem;
    font-style: italic;
  }

  .entry-title {
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
    color: var(--white);
  }

  .entry-thesis {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--white-dim);
    margin: 0;
  }

  .content-en { display: block; }
  .content-pl { display: none; }

  .empty {
    color: var(--white-dim);
    font-style: italic;
  }

  .footer-note {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .footer-note .note-text {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--white-dim);
    font-style: italic;
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 1.8rem; }
  }
</style>

<script>
  const lang = localStorage.getItem('cuktai-lang') || 'en';

  function updateDziennikLanguage(targetLang) {
    if (targetLang === 'pl') {
      document.querySelectorAll('.content-en').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.content-pl').forEach(el => el.style.display = 'block');
    } else {
      document.querySelectorAll('.content-en').forEach(el => el.style.display = 'block');
      document.querySelectorAll('.content-pl').forEach(el => el.style.display = 'none');
    }
  }

  if (lang === 'pl') {
    updateDziennikLanguage('pl');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const langToggle = document.getElementById('lang-toggle');
    if (langToggle) {
      langToggle.addEventListener('click', () => {
        setTimeout(() => {
          const newLang = localStorage.getItem('cuktai-lang') || 'en';
          updateDziennikLanguage(newLang);
        }, 10);
      });
    }
  });
</script>
