---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('archiwistka');
// Only show teczka type (not karta), sort by date
const teczki = docs
  .filter(d => d.data.type === 'teczka')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title="CUKTAI Archive — Teczki Śledcze" description="Official investigation files of the Autonomous Bureau of Technical Culture. 13+ CUKT projects investigated by Archiwistka.">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-title" id="page-glitch" data-text="ARCHIVE" data-en="ARCHIVE" data-pl="ARCHIWUM">ARCHIVE</h1>
      <p class="page-sub" data-en="OFFICIAL INVESTIGATION FILES — TECZKI ŚLEDCZE" data-pl="OFICJALNE TECZKI ŚLEDCZE URZĘDU">OFFICIAL INVESTIGATION FILES — TECZKI ŚLEDCZE</p>
      <p class="page-desc" data-en="Each project investigated by Archiwistka following official bureau protocol. Evidence, contradictions, open questions, white spaces. These are living documents — updated as new material is discovered." data-pl="Każdy projekt zbadany przez Archiwistkę zgodnie z protokołem urzędu. Dowody, sprzeczności, pytania otwarte, białe plamy. To żywe dokumenty — aktualizowane w miarę odkrywania nowych materiałów.">Each project investigated by Archiwistka following official bureau protocol. Evidence, contradictions, open questions, white spaces. These are living documents — updated as new material is discovered.</p>
    </div>
  </section>

  <section class="archive-list">
    <div class="container">
      <div class="grid-projects">
        {teczki.map((doc, i) => (
          <a href={`/archive/${doc.id}`} class="project-card">
            <div class="card-top">
              <span class="card-number">{String(i + 1).padStart(2, '0')}</span>
              <span class={`card-status ${doc.data.status === 'COMPLETE' ? 'complete' : 'progress'}`}>{doc.data.status}</span>
            </div>
            <h3>{doc.data.title}</h3>
            <p class="meta">{doc.data.date}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding: 6vw 0 3vw; border-bottom: 1px solid var(--border); overflow: hidden; }
  .page-title { font-size: 10vw; font-weight: 800; letter-spacing: 0.05em; color: var(--red); line-height: 0.9; position: relative; }
  .page-title::before,.page-title::after { content: attr(data-text); position: absolute; top:0;left:0;width:100%;height:100%; }
  .page-title::before { color:var(--green);animation:pg1 8s infinite;clip-path:polygon(0 0,100% 0,100% 33%,0 33%);opacity:0; }
  .page-title::after { color:var(--white);animation:pg2 6s infinite 2s;clip-path:polygon(0 67%,100% 67%,100% 100%,0 100%);opacity:0; }
  @keyframes pg1{0%,95%{opacity:0;transform:translate(0)}96%{opacity:.6;transform:translate(-2px,1px)}97%{opacity:.4;transform:translate(2px,-1px)}98%{opacity:.7;transform:translate(-1px,-1px)}99%,100%{opacity:0;transform:translate(0)}}
  @keyframes pg2{0%,93%{opacity:0;transform:translate(0)}94%{opacity:.5;transform:translate(2px,-2px)}95%{opacity:.3;transform:translate(-2px,1px)}96%{opacity:.6;transform:translate(1px,-1px)}97%,100%{opacity:0;transform:translate(0)}}
  .page-sub { font-size: 1.2vw; font-weight: 700; letter-spacing: 0.2em; color: var(--white-dim); margin-top: var(--space-md); }
  .page-desc { font-size: 0.85rem; color: var(--white-dim); margin-top: var(--space-md); max-width: 72ch; line-height: 1.8; }

  .archive-list { padding: var(--space-xl) 0; }

  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-xs); }
  .card-number { color: var(--red-dim); font-size: 0.7rem; letter-spacing: 0.1em; }
  .card-status { font-size: 0.6rem; letter-spacing: 0.15em; padding: 2px 6px; border: 1px solid; }
  .card-status.complete { color: var(--green); border-color: var(--green-dim); }
  .card-status.progress { color: var(--red); border-color: var(--red-dim); }
  .project-card h3 { color: var(--white); }

  @media (max-width: 768px) { .page-title{font-size:14vw;} .page-sub{font-size:3vw;} }
</style>

<script>
  const chars='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
  function scramble(el:Element,text:string,dur=1200){const len=text.length;let f=0;const tot=dur/30;const iv=setInterval(()=>{let r='';for(let i=0;i<len;i++){const p=f/tot,c=i/len;r+=p>c+.3?text[i]:chars[Math.floor(Math.random()*chars.length)];}el.textContent=r;f++;if(f>tot){el.textContent=text;clearInterval(iv);}},30);}
  const t=document.getElementById('page-glitch');if(t){const tx=t.textContent||'';setTimeout(()=>scramble(t,tx,1000),200);setInterval(()=>scramble(t,t.getAttribute('data-text')||tx,600),12000+Math.random()*8000);}
  const lang=localStorage.getItem('cuktai-lang')||'en';document.querySelectorAll('[data-pl][data-en]').forEach(el=>{const v=el.getAttribute(`data-${lang}`);if(v){el.textContent=v;if(el.hasAttribute('data-text'))el.setAttribute('data-text',v);}});
</script>
