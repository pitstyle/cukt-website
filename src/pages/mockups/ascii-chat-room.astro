---
/*
  MOCKUP — DO NOT MERGE
  Clerk ASCII office on top (fully visible, same long-legs drawing).
  Live-style chat below. Static Mikołaj exchange — no network.
  Copy: src/pages/agents/[id].astro (mikolaj).
*/

import AsciiRoom from "../../components/mockups/AsciiRoom.astro";

const agent = {
  name: "MIKOŁAJ",
  quote: "\"Both are right. Two frequencies of the same wave.\"",
  quotePl: "\"Obaj mają rację. Dwie częstotliwości tej samej fali.\"",
  greeting: "Mikołaj... cicho. I'm listening.",
  userLine: "Peter and Ewa contradict each other. Who is right?",
  chatNote: "The agent uses Hermes memory and the CUKTAI archive. Same persona as Telegram.",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>ASCII Mockup — Chat room (Mikołaj)</title>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&display=swap");

    :root {
      --red: #da4444;
      --white: #ffffff;
      --white-dim: #c8c8c8;
      --green: #00cc00;
      --bg: #050505;
      --bg-panel: #0a0a0a;
      --border: #222222;
      --font-mono: "JetBrains Mono", ui-monospace, "Courier New", monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      overflow-x: hidden;
      max-width: 100%;
    }

    body {
      font-family: var(--font-mono);
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    .mockup-banner {
      font-size: 12px;
      letter-spacing: 0.12em;
      color: var(--red);
      border-bottom: 1px solid var(--border);
      padding: 10px 16px;
      text-align: center;
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 16px 48px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-size: 14px;
      letter-spacing: 0.1em;
      color: var(--white-dim);
      margin: 16px 0;
      padding: 10px 14px;
      border: 1px solid var(--border);
    }

    .back-link:hover { color: var(--white); border-color: var(--red); }

    .agent-quote {
      border-left: 3px solid var(--red);
      padding-left: 12px;
      font-style: italic;
      color: var(--white-dim);
      font-size: 16px;
      margin: 0 0 16px;
    }

    .room-clerk {
      border: 1px solid var(--border);
      border-bottom: none;
      background: #000;
      padding: 12px 8px 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .room-clerk :global(.ascii-room) {
      color: var(--white);
      width: max-content;
      max-width: 100%;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .chat-container {
      border: 1px solid var(--border);
      background: var(--bg-panel);
    }

    .chat-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      background: #000;
    }

    .chat-status { color: var(--green); letter-spacing: 0.1em; }
    .chat-label { color: var(--white-dim); letter-spacing: 0.08em; }

    .chat-messages {
      min-height: 160px;
      padding: 16px;
    }

    .msg { margin-bottom: 16px; }
    .msg:last-child { margin-bottom: 0; }

    .msg-name {
      display: block;
      font-size: 12px;
      letter-spacing: 0.1em;
      color: var(--green);
      margin-bottom: 8px;
      font-weight: 700;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--border);
    }

    .msg-user .msg-name { color: var(--red); }

    .msg-text {
      display: block;
      font-size: 16px;
      line-height: 1.7;
      color: var(--white);
      overflow-wrap: anywhere;
    }

    .msg-user .msg-text { color: var(--white); }
    .msg-pl { color: var(--white-dim); font-style: italic; margin-top: 8px; }

    .chat-input {
      display: flex;
      border-top: 1px solid var(--border);
    }

    .desk-field {
      flex: 1;
      display: flex;
      align-items: center;
      min-width: 0;
      min-height: 44px;
      padding: 0 8px 0 12px;
      color: var(--white-dim);
      font-size: 16px;
      background: var(--bg);
    }

    .desk-field input {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      background: transparent;
      border: none;
      color: var(--white);
      font-family: var(--font-mono);
      font-size: 16px;
      outline: none;
      padding: 12px 4px;
    }

    .desk-field input::placeholder { color: #666; }

    .desk-send {
      min-width: 88px;
      min-height: 44px;
      background: #000;
      border: none;
      border-left: 1px solid var(--border);
      color: var(--red);
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 12px 12px;
      cursor: pointer;
    }

    .chat-note {
      padding: 8px 16px;
      font-size: 12px;
      color: #888;
      border-top: 1px solid var(--border);
    }
  </style>
</head>
<body>
  <div class="mockup-banner">DRAFT MOCKUP — DO NOT MERGE</div>
  <div class="container">
    <a href="/mockups/ascii-agent-room" class="back-link">← AGENT ROOM MOCKUP</a>

    <blockquote class="agent-quote">{agent.quote}</blockquote>

    <div class="room-clerk" id="ascii-chat-room">
      <AsciiRoom variant="clerk" />
    </div>

    <div class="chat-container" id="chat">
      <div class="chat-header">
        <span class="chat-status">● ONLINE</span>
        <span class="chat-label">TALKING TO {agent.name}</span>
      </div>
      <div class="chat-messages">
        <div class="msg">
          <span class="msg-name">{agent.name}</span>
          <span class="msg-text">{agent.greeting}</span>
        </div>
        <div class="msg msg-user">
          <span class="msg-name">YOU</span>
          <span class="msg-text">{agent.userLine}</span>
        </div>
        <div class="msg">
          <span class="msg-name">{agent.name}</span>
          <span class="msg-text">{agent.quote}</span>
          <span class="msg-text msg-pl">{agent.quotePl}</span>
        </div>
      </div>
      <form class="chat-input" id="ascii-chat-form">
        <label class="desk-field">
          [
          <input type="text" placeholder="Type your message..." autocomplete="off" aria-label="Type your message" />
          _]
        </label>
        <button class="desk-send" type="submit">[ SEND ]</button>
      </form>
      <div class="chat-note">{agent.chatNote}</div>
    </div>
  </div>
  <script>
    document.getElementById("ascii-chat-form")?.addEventListener("submit", (ev) => {
      ev.preventDefault();
    });
  </script>
</body>
</html>
