<script>
  // Language toggle handler (2026 about blocks; 2024 section is English-only)
  const lang = localStorage.getItem('cuktai-lang') || 'en';
  
  // Show/hide content based on language
  if (lang === 'en') {
    document.querySelectorAll('.about-en').forEach(el => el.style.display = 'block');
    document.querySelectorAll('.about-pl').forEach(el => el.style.display = 'none');
  } else {
    document.querySelectorAll('.about-en').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.about-pl').forEach(el => el.style.display = 'block');
  }

  // Edition tab active state
  const editionTabs = document.querySelectorAll('.edition-tab');
  function setActiveEdition(edition: string) {
    editionTabs.forEach((tab) => {
      const isActive = tab.getAttribute('data-edition') === edition;
      tab.classList.toggle('is-active', isActive);
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
  }

  editionTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const edition = tab.getAttribute('data-edition');
      if (edition) setActiveEdition(edition);
    });
  });

  if (location.hash === '#technopera-2024') setActiveEdition('2024');
</script>
