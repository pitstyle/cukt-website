---
import Base from '../layouts/Base.astro';
import { BOOKING_EMAIL, NEWSLETTER_FORM_URL } from '../data/technopera.ts';
---

<Base 
  title="Technopera 2026 · Mediateka Tychy · 4.10"
  description="Technopera 2026 — AUTHORITY. KNOWLEDGE. SEAL. A multimedia opera for the age of AI by Piotr Wyrzykowski. Premiere: MEDIATEKA, Tychy, 4.10.2026, 20:45."
  ogTitle="Technopera 2026 — AUTHORITY. KNOWLEDGE. SEAL."
  image="/og/technopera-2026.jpg"
  imageAlt="Technopera 2026 — AUTHORITY. KNOWLEDGE. SEAL. · MEDIATEKA · Tychy · 4.10.2026 · 20:45"
>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TheaterEvent",
  "name": "Technopera 2026 — AUTHORITY. KNOWLEDGE. SEAL.",
  "startDate": "2026-10-04T20:45:00+02:00",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "MEDIATEKA",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "al. marsz. J. Piłsudskiego 16",
