  "description": "Multimedia opera for the age of AI. Part of the AUKSODRONE festival.",
  "director": {
    "@type": "Person",
    "name": "Piotr Wyrzykowski",
    "email": "peter@cukt.click"
  },
  "organizer": {
    "@type": "Organization",
    "name": "AUKSO – Chamber Symphony Orchestra of the City of Tychy"
