<script>
  // Language toggle handler
  const lang = localStorage.getItem('cuktai-lang') || 'en';
  
  // Show/hide content based on language
  if (lang === 'en') {
    document.querySelectorAll('.about-en').forEach(el => el.style.display = 'block');
    document.querySelectorAll('.about-pl').forEach(el => el.style.display = 'none');
  } else {
    document.querySelectorAll('.about-en').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.about-pl').forEach(el => el.style.display = 'block');
  }
</script>
