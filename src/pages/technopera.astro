    <p data-en="Info: AUKSODRONE / Mediateka · al. marsz. J. Piłsudskiego 16, Tychy" data-pl="Informacje: AUKSODRONE / Mediateka · al. marsz. J. Piłsudskiego 16, Tychy">Info: AUKSODRONE / Mediateka · al. marsz. J. Piłsudskiego 16, Tychy</p>
  </div>
</section>

</Base>

<style>
  /* HERO */
  .hero {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 0.9;
    letter-spacing: 0.05em;
    color: var(--red);
  }

  .hero-triad {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .triad-primary {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--white);
  }

  .triad-secondary {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--white-dim);
  }

  .hero-meta {
    font-size: 0.9rem;
    color: var(--white-dim);
    letter-spacing: 0.02em;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-md);
  }

  .btn {
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--red);
    color: var(--red);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.2s;
  }

  .btn:hover {
    background: var(--red);
    color: var(--bg);
  }

  .hero-info {
    font-size: 0.75rem;
    color: var(--white-dim);
  }

  .hero-video {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-loop {
    width: 100%;
    max-height: 80vh;
    aspect-ratio: 9/16;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-loop {
      animation: none;
    }
  }

  /* TRAILER */
  .trailer {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .trailer-placeholder {
    text-align: center;
    padding: var(--space-2xl) 0;
    border: 1px solid var(--border);
  }

  .trailer-label {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--red);
    margin-bottom: var(--space-md);
  }

  .trailer-caption {
    font-size: 0.85rem;
    color: var(--white-dim);
  }

  /* PITCH */
  .pitch {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .pitch-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--white);
    text-align: center;
    max-width: 72ch;
    margin: 0 auto;
  }

  /* ABOUT */
  .about {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .section-title {
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    color: var(--red);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .about-content {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--white-dim);
  }

  .about-content p {
    margin-bottom: var(--space-md);
  }

  .about-en, .about-pl {
    display: none;
  }

  .history-link {
    margin-top: var(--space-lg);
  }

  .history-link a {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--red);
  }

  /* CREDITS */
  .credits {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .credits-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .credit-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
  }

  .credit-label {
    font-size: 0.85rem;
    color: var(--white-dim);
  }

  .credit-name {
    font-size: 0.85rem;
    color: var(--white);
    font-weight: 700;
  }

  /* HISTORY */
  .history {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .timeline-item {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--border);
  }

  .timeline-item.highlight {
    border-color: var(--red);
  }

  .timeline-year {
    font-size: 1rem;
    font-weight: 800;
    color: var(--green);
    min-width: 100px;
    flex-shrink: 0;
  }

  .timeline-item.highlight .timeline-year {
    color: var(--red);
  }

  .timeline-content p {
    font-size: 0.85rem;
    color: var(--white-dim);
    line-height: 1.7;
  }

  /* BOOKING */
  .booking {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .booking-content {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--white-dim);
  }

  .booking-intro {
    margin-bottom: var(--space-lg);
  }

  .booking-contact {
    margin-bottom: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--red);
    background: rgba(255, 0, 0, 0.05);
  }

  .booking-contact strong {
    color: var(--white);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .contact-email {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--red);
    margin: var(--space-xs) 0;
    display: inline-block;
