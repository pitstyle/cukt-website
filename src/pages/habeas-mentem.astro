</style>

<script>
  // Apply stored language preference on load
  const lang = localStorage.getItem('cuktai-lang') || 'en';
  
  function updateHabeasMentemLanguage(targetLang) {
    if (targetLang === 'pl') {
      document.querySelectorAll('.question-en, .method-en, .why-en, .artist-en').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.question-pl, .method-pl, .why-pl, .artist-pl').forEach(el => el.style.display = 'block');
    } else {
      document.querySelectorAll('.question-en, .method-en, .why-en, .artist-en').forEach(el => el.style.display = 'block');
      document.querySelectorAll('.question-pl, .method-pl, .why-pl, .artist-pl').forEach(el => el.style.display = 'none');
    }
  }
  
  // Apply on load if stored preference is Polish
  if (lang === 'pl') {
    updateHabeasMentemLanguage('pl');
  }
  
  // Listen for language toggle events from the global toggle
  document.addEventListener('DOMContentLoaded', () => {
    const langToggle = document.getElementById('lang-toggle');
    if (langToggle) {
      langToggle.addEventListener('click', () => {
        // Wait a tick for localStorage to update
        setTimeout(() => {
          const newLang = localStorage.getItem('cuktai-lang') || 'en';
          updateHabeasMentemLanguage(newLang);
        }, 10);
      });
    }
  });
</script>
