<script>
  // Language toggle handler
  const lang = localStorage.getItem('cuktai-lang') || 'en';
  
  // Show/hide content based on language
  if (lang === 'en') {
    document.querySelectorAll('.question-en, .archive-en, .method-en, .why-en, .artist-en').forEach(el => el.style.display = 'block');
    document.querySelectorAll('.question-pl, .archive-pl, .method-pl, .why-pl, .artist-pl').forEach(el => el.style.display = 'none');
  } else {
    document.querySelectorAll('.question-en, .archive-en, .method-en, .why-en, .artist-en').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.question-pl, .archive-pl, .method-pl, .why-pl, .artist-pl').forEach(el => el.style.display = 'block');
  }
</script>
