</style>

<script define:vars={{ CHAT_API }}>
  // Apply stored language preference on load
  const lang = localStorage.getItem('cuktai-lang') || 'en';
  
  function updateHabeasMentemLanguage(targetLang) {
    if (targetLang === 'pl') {
      document.querySelectorAll('.content-en, .artist-en').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.content-pl, .artist-pl').forEach(el => el.style.display = 'block');
    } else {
      document.querySelectorAll('.content-en, .artist-en').forEach(el => el.style.display = 'block');
      document.querySelectorAll('.content-pl, .artist-pl').forEach(el => el.style.display = 'none');
    }
  }
  
  // Apply on load if stored preference is Polish
  if (lang === 'pl') {
    updateHabeasMentemLanguage('pl');
  }
  
  // Listen for language toggle events from the global toggle
  document.addEventListener('DOMContentLoaded', () => {
    const langToggle = document.getElementById('lang-toggle');
    if (langToggle) {
      langToggle.addEventListener('click', () => {
        // Wait a tick for localStorage to update
        setTimeout(() => {
          const newLang = localStorage.getItem('cuktai-lang') || 'en';
          updateHabeasMentemLanguage(newLang);
        }, 10);
      });
    }

    // Load journal and bill data
    loadJournalData();
    loadBillData();
  });

  // Validate URL - only allow http/https
  function isValidUrl(url) {
    try {
      const parsed = new URL(url);
      return parsed.protocol === 'http:' || parsed.protocol === 'https:';
    } catch {
      return false;
    }
  }

  // Safely render text content preserving structure
  function renderText(text) {
    const lines = text.split('\n');
    const container = document.createDocumentFragment();
    lines.forEach((line, i) => {
      if (i > 0) container.appendChild(document.createElement('br'));
      container.appendChild(document.createTextNode(line));
    });
    return container;
  }

  async function loadBillData() {
    const billInfo = document.getElementById('bill-info');
    if (!billInfo) return;

    const currentLang = localStorage.getItem('cuktai-lang') || 'en';

    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 8000);

      const response = await fetch(`${CHAT_API}/api/public/habeas/bill`, {
        signal: controller.signal
      });
      clearTimeout(timeoutId);

      if (!response.ok) throw new Error('API error');

      const data = await response.json();
      
      billInfo.innerHTML = '';

      // Version and updated
      const versionDiv = document.createElement('div');
      versionDiv.className = 'bill-version';
      versionDiv.appendChild(document.createTextNode(
        currentLang === 'pl' 
          ? `Wersja projektu: ${data.version}` 
          : `Bill version: ${data.version}`
      ));
      billInfo.appendChild(versionDiv);

      if (data.updated) {
        const updatedDiv = document.createElement('div');
        updatedDiv.className = 'bill-updated';
        updatedDiv.appendChild(document.createTextNode(
          currentLang === 'pl' 
            ? `Ostatnia aktualizacja: ${data.updated}` 
            : `Last updated: ${data.updated}`
        ));
        billInfo.appendChild(updatedDiv);
      }

      // Changelog
      if (data.changelog && data.changelog.length > 0) {
        const changelogTitle = document.createElement('div');
        changelogTitle.className = 'changelog-title';
        changelogTitle.appendChild(document.createTextNode(
          currentLang === 'pl' ? 'Historia zmian:' : 'Changelog:'
        ));
        billInfo.appendChild(changelogTitle);

        data.changelog.forEach(entry => {
          const entryDiv = document.createElement('div');
          entryDiv.className = 'changelog-entry';

          const versionSpan = document.createElement('div');
          versionSpan.className = 'changelog-version';
          versionSpan.appendChild(document.createTextNode(`v${entry.version}`));
          entryDiv.appendChild(versionSpan);

          if (entry.date) {
            const dateSpan = document.createElement('div');
            dateSpan.className = 'changelog-date';
            dateSpan.appendChild(document.createTextNode(entry.date));
            entryDiv.appendChild(dateSpan);
          }

          const summary = document.createElement('div');
          summary.className = 'changelog-summary';
          const summaryText = currentLang === 'pl' ? entry.summary_pl : entry.summary_en;
          summary.appendChild(renderText(summaryText || ''));
          entryDiv.appendChild(summary);

          billInfo.appendChild(entryDiv);
        });
      }
    } catch (error) {
      billInfo.innerHTML = '';
      const errorDiv = document.createElement('div');
      errorDiv.className = 'bill-error';
      
      if (currentLang === 'pl') {
        errorDiv.appendChild(document.createTextNode('Informacje o projekcie tymczasowo niedostępne. '));
        const link = document.createElement('a');
        link.href = 'https://www.instagram.com/wiktoriacukt/';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.appendChild(document.createTextNode('Śledź @wiktoriacukt'));
        errorDiv.appendChild(link);
      } else {
        errorDiv.appendChild(document.createTextNode('Bill information temporarily unavailable. '));
        const link = document.createElement('a');
        link.href = 'https://www.instagram.com/wiktoriacukt/';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.appendChild(document.createTextNode('Follow @wiktoriacukt'));
        errorDiv.appendChild(link);
      }
      
      billInfo.appendChild(errorDiv);
    }
  }

  async function loadJournalData() {
    const journalEntries = document.getElementById('journal-entries');
    if (!journalEntries) return;

    const currentLang = localStorage.getItem('cuktai-lang') || 'en';

    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 8000);

      const response = await fetch(`${CHAT_API}/api/public/habeas/journal?limit=20`, {
        signal: controller.signal
      });
      clearTimeout(timeoutId);

      if (!response.ok) throw new Error('API error');

      const data = await response.json();

      journalEntries.innerHTML = '';

      if (!data.entries || data.entries.length === 0) {
        const emptyDiv = document.createElement('div');
        emptyDiv.className = 'journal-empty';
        emptyDiv.appendChild(document.createTextNode(
          currentLang === 'pl' 
            ? 'Pierwsze wpisy wkrótce...' 
            : 'First entries coming soon...'
        ));
        journalEntries.appendChild(emptyDiv);
        return;
      }

      data.entries.forEach(entry => {
        const entryDiv = document.createElement('div');
        entryDiv.className = 'journal-entry';

        // Date
        if (entry.date) {
          const dateDiv = document.createElement('div');
          dateDiv.className = 'entry-date';
          dateDiv.appendChild(document.createTextNode(entry.date));
          entryDiv.appendChild(dateDiv);
        }

        // Title
        const titleDiv = document.createElement('div');
        titleDiv.className = 'entry-title';
        const titleText = currentLang === 'pl' ? entry.title_pl : entry.title_en;
        titleDiv.appendChild(renderText(titleText || ''));
        entryDiv.appendChild(titleDiv);

        // Body
        const bodyDiv = document.createElement('div');
        bodyDiv.className = 'entry-body';
        const bodyText = currentLang === 'pl' ? entry.body_pl : entry.body_en;
        bodyDiv.appendChild(renderText(bodyText || ''));
        entryDiv.appendChild(bodyDiv);

        // Sources
        if (entry.sources && entry.sources.length > 0) {
          const sourcesTitle = document.createElement('div');
          sourcesTitle.className = 'entry-sources-title';
          sourcesTitle.appendChild(document.createTextNode(
            currentLang === 'pl' ? 'Źródła:' : 'Sources:'
          ));
          entryDiv.appendChild(sourcesTitle);

          const sourcesList = document.createElement('ol');
          sourcesList.className = 'entry-sources';

          entry.sources.forEach(source => {
            const sourceLi = document.createElement('li');
            
            if (source.url && isValidUrl(source.url)) {
              const link = document.createElement('a');
              link.href = source.url;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              
              let linkText = source.title || source.url;
              if (source.authors) linkText += ` — ${source.authors}`;
              if (source.year) linkText += ` (${source.year})`;
              
              link.appendChild(document.createTextNode(linkText));
              sourceLi.appendChild(link);
            } else {
              let text = source.title || '';
              if (source.authors) text += ` — ${source.authors}`;
              if (source.year) text += ` (${source.year})`;
              sourceLi.appendChild(document.createTextNode(text));
            }

            sourcesList.appendChild(sourceLi);
          });

          entryDiv.appendChild(sourcesList);
        }

        journalEntries.appendChild(entryDiv);
      });
    } catch (error) {
      journalEntries.innerHTML = '';
      const errorDiv = document.createElement('div');
      errorDiv.className = 'journal-error';
      
      if (currentLang === 'pl') {
        errorDiv.appendChild(document.createTextNode('Dziennik tymczasowo niedostępny. '));
        const link = document.createElement('a');
        link.href = 'https://www.instagram.com/wiktoriacukt/';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.appendChild(document.createTextNode('Śledź @wiktoriacukt'));
        errorDiv.appendChild(link);
      } else {
        errorDiv.appendChild(document.createTextNode('Journal temporarily unavailable. '));
        const link = document.createElement('a');
        link.href = 'https://www.instagram.com/wiktoriacukt/';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.appendChild(document.createTextNode('Follow @wiktoriacukt'));
        errorDiv.appendChild(link);
      }
      
      journalEntries.appendChild(errorDiv);
    }
  }
</script>
